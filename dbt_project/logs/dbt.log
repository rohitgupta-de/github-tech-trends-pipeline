WITH silver_data AS (
    SELECT *
    FROM read_json_auto('/opt/airflow/data/silver/clean_repos_*.json')
)

SELECT
    id,
    name,
    full_name,
    owner_login,
    stargazers_count,
    forks_count,
    open_issues_count,
    language,
    -- Custom Analytics Metrics
    ROUND(CAST(stargazers_count AS DOUBLE) / NULLIF(forks_count, 0), 2) AS star_to_fork_ratio,
    (stargazers_count * 1.0) + (forks_count * 2.0) - (open_issues_count * 0.5) AS repo_health_score,
    CURRENT_TIMESTAMP AS transformed_at
FROM silver_data
ORDER BY stargazers_count DESC
    );
  
  
